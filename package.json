{
  "name": "animatic",
  "version": "1.0.1",
  "description": "CSS/JS Animations Library with Physics support",
  "main": "animatic.js",
  "module": "animatic.esm.js",
  "keywords": [
    "animation",
    "animations",
    "transition",
    "transitions",
    "css",
    "javascript",
    "physics"
  ],
  "scripts": {
    "build": "make -B",
    "lint": "oxlint src test editor jquery.animatic.js --deny-warnings",
    "smoke": "node test/smoke.mjs",
    "prepublish": "make -B"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lvivski/animatic.git"
  },
  "devDependencies": {
    "esbuild": "^0.25.5",
    "oxlint": "^1.67.0"
  },
  "license": "MIT",
  "prettier": {
    "singleQuote": false,
    "trailingComma": "none",
    "semi": false
  }
}
